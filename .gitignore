# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# encrypted token store
/data/

# sqlite database, plus the daily snapshots Budget.command archives into
# prisma/backups/ — both hold real financial data.
*.db
*.db-journal
/prisma/backups/

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Venmo parse cache (contains personal data)
/scripts/.venmo-parsed.json

# parallel-session dev build dir (see next.config.ts NEXT_DIST_DIR)
/.next-preview/
.server.log

# machine-local Claude Code settings
.claude/settings.local.json
/.claude/worktrees/

# scratch files written by npm test (scripts/test-ui-state.mjs)
/.test-tmp/
